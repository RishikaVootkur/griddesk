# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your-gemini-free-tier-key
GROQ_API_KEY=your-groq-free-tier-key
OLLAMA_BASE_URL=http://localhost:11434

# Operator console token (required by the API). Generate one: openssl rand -hex 32
OPERATOR_TOKEN=
# OPERATOR_ID=console            # identity recorded on approval decisions
# GRIDDESK_OPERATOR_AUTH=off     # local development only: run the API without operator auth

# Optional overrides
# DATABASE_URL=postgresql+psycopg://griddesk:griddesk@localhost:5433/griddesk
# TRACING_ENABLED=true
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
# CACHE_MODE=read_write   # off | read_write | replay_only
